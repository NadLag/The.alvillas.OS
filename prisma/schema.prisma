  organizationId                         String                 @map("organization_id") @db.Uuid
  propertyId                             String                 @map("property_id") @db.Uuid
  kind                                   String
  source                                 String
  externalId                             String?                @map("external_id")
  checkIn                                DateTime               @map("check_in") @db.Date
  checkOut                               DateTime               @map("check_out") @db.Date
  reason                                 String?
  status                                 String                 @default("ACTIVE")
  idempotencyKey                         String                 @map("idempotency_key")
  archivedAt                             DateTime?              @map("archived_at") @db.Timestamptz(6)
  createdBy                              String?                @map("created_by") @db.Uuid
  createdAt                              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                              DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantOrganization                     Organization           @relation("ReservationCalendarBlockOrganization", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "calendar_block_organization_fk")
  reverseReservationFeedEntryblockIdLink ReservationFeedEntry[] @relation("ReservationFeedEntryblockIdLink")
  linkedpropertyId                       Property               @relation("CalendarBlockpropertyIdLink", fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "calendar_block_property_id_tenant_fk")

  @@unique([organizationId, idempotencyKey], map: "calendar_block_org_idempotency_unique")
  @@unique([organizationId, id], map: "calendar_block_org_id_unique")
  @@index([organizationId, propertyId, checkIn, checkOut], map: "calendar_block_org_property_dates_idx")
  @@map("calendar_block")
}

