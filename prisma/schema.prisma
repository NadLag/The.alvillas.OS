model Variance {
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  sourceType     String       @map("source_type")
  sourceId       String       @map("source_id") @db.Uuid
  propertyId     String?      @map("property_id") @db.Uuid
  reservationId  String?      @map("reservation_id") @db.Uuid
  expectedAmount Decimal      @map("expected_amount") @db.Decimal(18, 2)
  actualAmount   Decimal      @map("actual_amount") @db.Decimal(18, 2)
  varianceAmount Decimal      @map("variance_amount") @db.Decimal(18, 2)
  currency       String       @db.Char(3)
  reason         String
  action         String
  status         String       @default("OPEN")
  assignedTo     String?      @map("assigned_to") @db.Uuid
  resolvedBy     String?      @map("resolved_by") @db.Uuid
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(6)
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reservation    Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  currencyRef    Currency     @relation(fields: [currency], references: [code], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, status, createdAt], map: "variance_org_status_created_idx")
  @@index([organizationId, sourceType, sourceId], map: "variance_org_source_idx")
  @@index([organizationId, propertyId, status], map: "variance_org_property_status_idx")
  @@map("variance")
}

