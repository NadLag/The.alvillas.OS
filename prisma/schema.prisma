generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String                       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  name                 String
  baseCurrency         String                       @default("MAD") @map("base_currency") @db.Char(3)
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  configRules          ConfigRule[]
  reservationSnapshots ReservationConfigSnapshot[]
  outboxEvents         OutboxEvent[]
  auditLogs            AuditLog[]
  referenceSequences   ReferenceSequence[]
  exchangeRates        ExchangeRate[]
  ledgerAccounts       LedgerAccount[]
  transactions         FinancialTransaction[]
  postings             Posting[]
  commissionSnapshots  CommissionSnapshot[]
  rateLimitBuckets     RateLimitBucket[]
  persons              Person[]
  userAccounts         UserAccount[]
  authCredentials      AuthCredential[]
  authSessions         AuthSession[]
  authDevices          AuthDevice[]
  authChallenges       AuthChallenge[]
  invitations          Invitation[]
  roles                Role[]
  permissions          Permission[]
  fieldPolicies        FieldPolicy[]
  roleAssignments      RoleAssignment[]
  rolePermissions      RolePermission[]
  owners               Owner[]
  ownerRepresentatives OwnerRepresentative[]
  ownerPayoutMethods   OwnerPayoutMethod[]
  ownerPortalAccesses  OwnerPortalAccess[]
  properties           Property[]
  propertyProfiles     PropertyOnboardingProfile[]
  propertyOwners       PropertyOwner[]
  reservations         Reservation[]
  reservationConflicts ReservationConflict[]
  operationTasks       OperationTask[]
  taskChecklistItems   OperationTaskChecklistItem[]
  syncOps              SyncOp[]
  airbnbSettlements    AirbnbSettlement[]
  variances            Variance[]

  @@map("organization")
}

model Person {
  id              String                       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String                       @map("organization_id") @db.Uuid
  displayName     String                       @map("display_name")
  email           String?
  phone           String?
  preferredLocale String                       @default("en") @map("preferred_locale") @db.Char(2)
  archivedAt      DateTime?                    @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  userAccounts    UserAccount[]
  assignedTasks   OperationTask[]              @relation("OperationTaskAssignedPerson")
  completedTasks  OperationTask[]              @relation("OperationTaskCompletedPerson")
  completedChecks OperationTaskChecklistItem[] @relation("OperationTaskChecklistCompletedPerson")
  syncOps         SyncOp[]                     @relation("SyncOpActorPerson")
  invitations     Invitation[]
  roleAssignments RoleAssignment[]

  @@unique([organizationId, email], map: "person_org_email_unique")
  @@index([organizationId, phone], map: "person_org_phone_idx")
  @@index([organizationId, displayName], map: "person_org_display_name_idx")
  @@map("person")
}

model UserAccount {
  id                  String                       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId      String                       @map("organization_id") @db.Uuid
  personId            String                       @map("person_id") @db.Uuid
  email               String?
  phone               String?
  passwordHash        String?                      @map("password_hash")
  status              String                       @default("ACTIVE")
  sessionVersion      Int                          @default(1) @map("session_version")
  mfaRequired         Boolean                      @default(false) @map("mfa_required")
  lastLoginAt         DateTime?                    @map("last_login_at") @db.Timestamptz(6)
  suspendedAt         DateTime?                    @map("suspended_at") @db.Timestamptz(6)
  deactivatedAt       DateTime?                    @map("deactivated_at") @db.Timestamptz(6)
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  person              Person                       @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  authCredentials     AuthCredential[]
  authSessions        AuthSession[]
  authDevices         AuthDevice[]
  authChallenges      AuthChallenge[]
  invitations         Invitation[]
  roleAssignments     RoleAssignment[]
  assignedTasks       OperationTask[]              @relation("OperationTaskAssignedAccount")
  completedTasks      OperationTask[]              @relation("OperationTaskCompletedAccount")
  completedChecks     OperationTaskChecklistItem[] @relation("OperationTaskChecklistCompletedAccount")
  syncOps             SyncOp[]                     @relation("SyncOpActorAccount")
  ownerPortalAccesses OwnerPortalAccess[]

  @@unique([organizationId, email], map: "user_account_org_email_unique")
  @@unique([organizationId, phone], map: "user_account_org_phone_unique")
  @@index([organizationId, personId], map: "user_account_org_person_idx")
  @@index([organizationId, status], map: "user_account_org_status_idx")
  @@map("user_account")
}

model AuthCredential {
  id              String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  userAccountId   String       @map("user_account_id") @db.Uuid
  type            String
  label           String?
  secretHash      String?      @map("secret_hash")
  secretEncrypted String?      @map("secret_encrypted")
  credentialId    String?      @map("credential_id")
  publicKey       Bytes?       @map("public_key")
  counter         Int          @default(0)
  transports      Json?
  backupEligible  Boolean      @default(false) @map("backup_eligible")
  backedUp        Boolean      @default(false) @map("backed_up")
  lastUsedAt      DateTime?    @map("last_used_at") @db.Timestamptz(6)
  expiresAt       DateTime?    @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  userAccount     UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, type, credentialId], map: "auth_credential_org_type_credential_unique")
  @@index([organizationId, userAccountId, type, revokedAt], map: "auth_credential_org_user_type_idx")
  @@map("auth_credential")
}

model AuthSession {
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userAccountId  String       @map("user_account_id") @db.Uuid
  deviceId       String       @map("device_id")
  sessionVersion Int          @map("session_version")
  userAgent      String?      @map("user_agent")
  ipAddress      String?      @map("ip_address")
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  userAccount    UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, userAccountId, revokedAt, expiresAt], map: "auth_session_org_user_active_idx")
  @@index([organizationId, deviceId], map: "auth_session_org_device_idx")
  @@map("auth_session")
}

model AuthDevice {
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userAccountId  String       @map("user_account_id") @db.Uuid
  deviceId       String       @map("device_id")
  label          String?
  platform       String?
  trusted        Boolean      @default(false)
  registeredAt   DateTime     @default(now()) @map("registered_at") @db.Timestamptz(6)
  lastSeenAt     DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  userAccount    UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, userAccountId, deviceId], map: "auth_device_org_user_device_unique")
  @@index([organizationId, userAccountId, revokedAt], map: "auth_device_org_user_idx")
  @@map("auth_device")
}

model AuthChallenge {
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userAccountId  String?      @map("user_account_id") @db.Uuid
  type           String
  challenge      String
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime?    @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  userAccount    UserAccount? @relation(fields: [userAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, type, expiresAt], map: "auth_challenge_org_type_expires_idx")
  @@map("auth_challenge")
}

model Invitation {
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  personId       String       @map("person_id") @db.Uuid
  userAccountId  String?      @map("user_account_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  scopeType      String       @map("scope_type")
  scopeId        String?      @map("scope_id") @db.Uuid
  email          String?
  phone          String?
  codeHash       String       @map("code_hash")
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?    @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  person         Person       @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  userAccount    UserAccount? @relation(fields: [userAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, codeHash], map: "invitation_org_code_hash_unique")
  @@index([organizationId, personId, acceptedAt, revokedAt], map: "invitation_org_person_state_idx")
  @@index([organizationId, expiresAt], map: "invitation_org_expires_idx")
  @@map("invitation")
}

model Role {
  id              String           @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  key             String
  name            String
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  archivedAt      DateTime?        @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  invitations     Invitation[]
  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]

  @@unique([organizationId, key], map: "role_org_key_unique")
  @@index([organizationId, archivedAt], map: "role_org_archived_idx")
  @@map("role")
}

model Permission {
  id              String           @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  key             String
  resource        String
  action          String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rolePermissions RolePermission[]

  @@unique([organizationId, key], map: "permission_org_key_unique")
  @@index([organizationId, resource, action], map: "permission_org_resource_action_idx")
  @@map("permission")
}

model FieldPolicy {
  id                 String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  resource           String
  field              String
  dataClass          String       @map("data_class")
  requiredPermission String       @map("required_permission")
  mask               String       @default("placeholder")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, resource, field], map: "field_policy_org_resource_field_unique")
  @@index([organizationId, resource], map: "field_policy_org_resource_idx")
  @@map("field_policy")
}

model RolePermission {
  organizationId String       @map("organization_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  permissionId   String       @map("permission_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([organizationId, roleId, permissionId])
  @@index([organizationId, permissionId], map: "role_permission_org_permission_idx")
  @@map("role_permission")
}

model RoleAssignment {
  id              String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  personId        String       @map("person_id") @db.Uuid
  userAccountId   String?      @map("user_account_id") @db.Uuid
  roleId          String       @map("role_id") @db.Uuid
  scopeType       String       @map("scope_type")
  scopeId         String?      @map("scope_id") @db.Uuid
  conditions      Json?
  validFrom       DateTime     @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo         DateTime?    @map("valid_to") @db.Timestamptz(6)
  compensationRef String?      @map("compensation_ref")
  archivedAt      DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdBy       String?      @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  person          Person       @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  userAccount     UserAccount? @relation(fields: [userAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role            Role         @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, personId, archivedAt], map: "role_assignment_org_person_idx")
  @@index([organizationId, userAccountId, archivedAt], map: "role_assignment_org_account_idx")
  @@index([organizationId, roleId, scopeType, scopeId], map: "role_assignment_org_role_scope_idx")
  @@map("role_assignment")
}

model Owner {
  id                  String                @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  displayName         String                @map("display_name")
  legalName           String?               @map("legal_name")
  email               String?
  phone               String?
  preferredLocale     String                @default("fr") @map("preferred_locale") @db.Char(2)
  notes               String?
  archivedAt          DateTime?             @map("archived_at") @db.Timestamptz(6)
  createdBy           String?               @map("created_by") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  propertyOwners      PropertyOwner[]
  ownerPortalAccesses OwnerPortalAccess[]
  commissionSnapshots CommissionSnapshot[]
  representatives     OwnerRepresentative[]
  payoutMethods       OwnerPayoutMethod[]

  @@unique([organizationId, email], map: "owner_org_email_unique")
  @@index([organizationId, displayName], map: "owner_org_display_name_idx")
  @@index([organizationId, archivedAt], map: "owner_org_archived_idx")
  @@map("owner")
}

model OwnerRepresentative {
  id              String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  ownerId         String       @map("owner_id") @db.Uuid
  displayName     String       @map("display_name")
  email           String?
  phone           String?
  preferredLocale String       @default("fr") @map("preferred_locale") @db.Char(2)
  relationship    String?
  accessNotes     String?      @map("access_notes")
  validFrom       DateTime?    @map("valid_from") @db.Timestamptz(6)
  validTo         DateTime?    @map("valid_to") @db.Timestamptz(6)
  status          String       @default("ACTIVE")
  archivedAt      DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdBy       String?      @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  owner           Owner        @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, ownerId, email], map: "owner_representative_org_owner_email_unique")
  @@index([organizationId, ownerId, archivedAt], map: "owner_representative_org_owner_archived_idx")
  @@index([organizationId, status, validTo], map: "owner_representative_org_status_valid_idx")
  @@map("owner_representative")
}

model OwnerPayoutMethod {
  id                String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  ownerId           String       @map("owner_id") @db.Uuid
  label             String
  methodType        String       @map("method_type")
  accountHolderName String       @map("account_holder_name")
  currency          String       @db.Char(3)
  countryCode       String       @map("country_code") @db.Char(2)
  detailsEncrypted  String       @map("details_encrypted")
  maskedAccount     String       @map("masked_account")
  isDefault         Boolean      @default(false) @map("is_default")
  status            String       @default("ACTIVE")
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdBy         String?      @map("created_by") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  owner             Owner        @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  currencyRef       Currency     @relation(fields: [currency], references: [code], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, ownerId, archivedAt], map: "owner_payout_method_org_owner_archived_idx")
  @@index([organizationId, ownerId, isDefault], map: "owner_payout_method_org_owner_default_idx")
  @@map("owner_payout_method")
}

model OwnerPortalAccess {
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  ownerId        String       @map("owner_id") @db.Uuid
  userAccountId  String       @map("user_account_id") @db.Uuid
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  owner          Owner        @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  userAccount    UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, ownerId, userAccountId], map: "owner_portal_access_org_owner_user_unique")
  @@index([organizationId, userAccountId, archivedAt], map: "owner_portal_access_org_user_idx")
  @@index([organizationId, ownerId, archivedAt], map: "owner_portal_access_org_owner_idx")
  @@map("owner_portal_access")
}

model Property {
  id                  String                      @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId      String                      @map("organization_id") @db.Uuid
  name                String
  addressLine1        String                      @map("address_line_1")
  addressLine2        String?                     @map("address_line_2")
  city                String
  region              String?
  countryCode         String                      @default("MA") @map("country_code") @db.Char(2)
  propertyType        String                      @map("property_type")
  bedrooms            Int
  bathrooms           Int
  livingSpaces        Int                         @default(1) @map("living_spaces")
  hasPool             Boolean                     @default(false) @map("has_pool")
  hasGarden           Boolean                     @default(false) @map("has_garden")
  parkingSpaces       Int                         @default(0) @map("parking_spaces")
  maxGuests           Int                         @map("max_guests")
  timezone            String                      @default("Africa/Casablanca")
  amenities           Json
  photoUrls           Json                        @map("photo_urls")
  status              String                      @default("DRAFT")
  archivedAt          DateTime?                   @map("archived_at") @db.Timestamptz(6)
  createdBy           String?                     @map("created_by") @db.Uuid
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  propertyOwners      PropertyOwner[]
  Reservation         Reservation[]
  ReservationConflict ReservationConflict[]
  OperationTask       OperationTask[]
  commissionSnapshots CommissionSnapshot[]
  configSnapshots     ReservationConfigSnapshot[]
  airbnbSettlements   AirbnbSettlement[]
  variances           Variance[]
  onboardingProfile   PropertyOnboardingProfile?

  @@index([organizationId, city, name], map: "property_org_city_name_idx")
  @@index([organizationId, status], map: "property_org_status_idx")
  @@index([organizationId, archivedAt], map: "property_org_archived_idx")
  @@map("property")
}

model PropertyOnboardingProfile {
  id                  String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId      String       @map("organization_id") @db.Uuid
