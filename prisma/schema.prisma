generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String                       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  name                 String
  baseCurrency         String                       @default("MAD") @map("base_currency") @db.Char(3)
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  configRules          ConfigRule[]
  outboxEvents         OutboxEvent[]
  auditLogs            AuditLog[]
  referenceSequences   ReferenceSequence[]
  exchangeRates        ExchangeRate[]
  ledgerAccounts       LedgerAccount[]
  transactions         FinancialTransaction[]
  postings             Posting[]
  rateLimitBuckets     RateLimitBucket[]
  persons              Person[]
  userAccounts         UserAccount[]
  owners               Owner[]
  properties           Property[]
  propertyOwners       PropertyOwner[]
  reservations         Reservation[]
  reservationConflicts ReservationConflict[]
  operationTasks       OperationTask[]
  taskChecklistItems   OperationTaskChecklistItem[]
  syncOps              SyncOp[]

  @@map("organization")
}

model Person {
  id              String                       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String                       @map("organization_id") @db.Uuid
  displayName     String                       @map("display_name")
  email           String?
  phone           String?
  preferredLocale String                       @default("en") @map("preferred_locale") @db.Char(2)
  archivedAt      DateTime?                    @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  userAccounts    UserAccount[]
  assignedTasks   OperationTask[]              @relation("OperationTaskAssignedPerson")
  completedTasks  OperationTask[]              @relation("OperationTaskCompletedPerson")
  completedChecks OperationTaskChecklistItem[] @relation("OperationTaskChecklistCompletedPerson")
  syncOps         SyncOp[]                     @relation("SyncOpActorPerson")

  @@unique([organizationId, email], map: "person_org_email_unique")
  @@index([organizationId, displayName], map: "person_org_display_name_idx")
  @@map("person")
}

model UserAccount {
  id              String                       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String                       @map("organization_id") @db.Uuid
  personId        String                       @map("person_id") @db.Uuid
  email           String?
  passwordHash    String?                      @map("password_hash")
  status          String                       @default("ACTIVE")
  lastLoginAt     DateTime?                    @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  person          Person                       @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignedTasks   OperationTask[]              @relation("OperationTaskAssignedAccount")
  completedTasks  OperationTask[]              @relation("OperationTaskCompletedAccount")
  completedChecks OperationTaskChecklistItem[] @relation("OperationTaskChecklistCompletedAccount")
  syncOps         SyncOp[]                     @relation("SyncOpActorAccount")

  @@unique([organizationId, email], map: "user_account_org_email_unique")
  @@index([organizationId, personId], map: "user_account_org_person_idx")
  @@map("user_account")
}

model Owner {
  id              String          @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  displayName     String          @map("display_name")
  legalName       String?         @map("legal_name")
  email           String?
  phone           String?
  preferredLocale String          @default("fr") @map("preferred_locale") @db.Char(2)
  notes           String?
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(6)
  createdBy       String?         @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  propertyOwners  PropertyOwner[]

  @@unique([organizationId, email], map: "owner_org_email_unique")
  @@index([organizationId, displayName], map: "owner_org_display_name_idx")
  @@index([organizationId, archivedAt], map: "owner_org_archived_idx")
  @@map("owner")
}

model Property {
  id                  String                @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  name                String
  addressLine1        String                @map("address_line_1")
  addressLine2        String?               @map("address_line_2")
  city                String
  region              String?
  countryCode         String                @default("MA") @map("country_code") @db.Char(2)
  propertyType        String                @map("property_type")
  bedrooms            Int
  bathrooms           Int
  livingSpaces        Int                   @default(1) @map("living_spaces")
  hasPool             Boolean               @default(false) @map("has_pool")
  hasGarden           Boolean               @default(false) @map("has_garden")
  parkingSpaces       Int                   @default(0) @map("parking_spaces")
  maxGuests           Int                   @map("max_guests")
  timezone            String                @default("Africa/Casablanca")
  amenities           Json
  photoUrls           Json                  @map("photo_urls")
  status              String                @default("DRAFT")
  archivedAt          DateTime?             @map("archived_at") @db.Timestamptz(6)
  createdBy           String?               @map("created_by") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  propertyOwners      PropertyOwner[]
  Reservation         Reservation[]
  ReservationConflict ReservationConflict[]
  OperationTask       OperationTask[]

  @@index([organizationId, city, name], map: "property_org_city_name_idx")
  @@index([organizationId, status], map: "property_org_status_idx")
  @@index([organizationId, archivedAt], map: "property_org_archived_idx")
  @@map("property")
}

model PropertyOwner {
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  propertyId     String       @map("property_id") @db.Uuid
  ownerId        String       @map("owner_id") @db.Uuid
  shareBps       Int          @default(10000) @map("share_bps")
  isPrimary      Boolean      @default(true) @map("is_primary")
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  owner          Owner        @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, propertyId, ownerId], map: "property_owner_org_property_owner_unique")
  @@index([organizationId, ownerId], map: "property_owner_org_owner_idx")
  @@index([organizationId, propertyId], map: "property_owner_org_property_idx")
  @@map("property_owner")
}

model Reservation {
  id              String                @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  propertyId      String                @map("property_id") @db.Uuid
  reference       String
  source          String
  externalId      String?               @map("external_id")
  status          String                @default("CONFIRMED")
  guestName       String                @map("guest_name")
  guestEmail      String?               @map("guest_email")
  checkIn         DateTime              @map("check_in") @db.Date
  checkOut        DateTime              @map("check_out") @db.Date
  nights          Int
  adultCount      Int                   @default(1) @map("adult_count")
  childCount      Int                   @default(0) @map("child_count")
  notes           String?
  idempotencyKey  String                @map("idempotency_key")
  archivedAt      DateTime?             @map("archived_at") @db.Timestamptz(6)
  createdBy       String?               @map("created_by") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  property        Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  operationTasks  OperationTask[]
  conflicts       ReservationConflict[] @relation("ReservationConflictReservation")
  conflictingWith ReservationConflict[] @relation("ReservationConflictOther")

  @@unique([organizationId, reference], map: "reservation_org_reference_unique")
  @@unique([organizationId, idempotencyKey], map: "reservation_org_idempotency_unique")
  @@unique([organizationId, propertyId, source, externalId], map: "reservation_org_property_source_external_unique")
  @@index([organizationId, propertyId, checkIn, checkOut], map: "reservation_org_property_dates_idx")
  @@index([organizationId, source, externalId], map: "reservation_org_source_external_idx")
  @@map("reservation")
}

model ReservationConflict {
  id                       String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId           String       @map("organization_id") @db.Uuid
  propertyId               String       @map("property_id") @db.Uuid
  reservationId            String       @map("reservation_id") @db.Uuid
  conflictingReservationId String       @map("conflicting_reservation_id") @db.Uuid
  reason                   String
  status                   String       @default("OPEN")
  createdBy                String?      @map("created_by") @db.Uuid
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  property                 Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reservation              Reservation  @relation("ReservationConflictReservation", fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  conflictingReservation   Reservation  @relation("ReservationConflictOther", fields: [conflictingReservationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, reservationId, conflictingReservationId], map: "reservation_conflict_pair_unique")
  @@index([organizationId, propertyId, status], map: "reservation_conflict_org_property_status_idx")
  @@map("reservation_conflict")
}

model OperationTask {
  id                       String                       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId           String                       @map("organization_id") @db.Uuid
  propertyId               String                       @map("property_id") @db.Uuid
  reservationId            String?                      @map("reservation_id") @db.Uuid
  assignedToUserAccountId  String?                      @map("assigned_to_user_account_id") @db.Uuid
  assignedToPersonId       String?                      @map("assigned_to_person_id") @db.Uuid
  completedByUserAccountId String?                      @map("completed_by_user_account_id") @db.Uuid
  completedByPersonId      String?                      @map("completed_by_person_id") @db.Uuid
  completionIdempotencyKey String?                      @map("completion_idempotency_key") @db.Uuid
  type                     String
  state                    String                       @default("PLANNED")
  priority                 String                       @default("NORMAL")
  dueDate                  DateTime                     @map("due_date") @db.Date
  titleTranslations        Json                         @map("title_translations")
  idempotencyKey           String                       @map("idempotency_key")
  completedAt              DateTime?                    @map("completed_at") @db.Timestamptz(6)
  archivedAt               DateTime?                    @map("archived_at") @db.Timestamptz(6)
  createdBy                String?                      @map("created_by") @db.Uuid
  createdAt                DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization             Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  property                 Property                     @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reservation              Reservation?                 @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignedToUserAccount    UserAccount?                 @relation("OperationTaskAssignedAccount", fields: [assignedToUserAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignedToPerson         Person?                      @relation("OperationTaskAssignedPerson", fields: [assignedToPersonId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  completedByUserAccount   UserAccount?                 @relation("OperationTaskCompletedAccount", fields: [completedByUserAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  completedByPerson        Person?                      @relation("OperationTaskCompletedPerson", fields: [completedByPersonId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  checklistItems           OperationTaskChecklistItem[]

  @@unique([organizationId, idempotencyKey], map: "operation_task_org_idempotency_unique")
  @@unique([organizationId, completionIdempotencyKey], map: "operation_task_org_completion_idempotency_unique")
  @@index([organizationId, dueDate, state], map: "operation_task_org_due_state_idx")
  @@index([organizationId, propertyId, dueDate], map: "operation_task_org_property_due_idx")
  @@index([organizationId, reservationId], map: "operation_task_org_reservation_idx")
  @@index([organizationId, assignedToUserAccountId, state, dueDate], map: "operation_task_org_assignee_state_due_idx")
  @@index([organizationId, completedAt], map: "operation_task_org_completed_at_idx")
  @@map("operation_task")
}

model OperationTaskChecklistItem {
  id                       String        @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId           String        @map("organization_id") @db.Uuid
  taskId                   String        @map("task_id") @db.Uuid
  key                      String
  labelTranslations        Json          @map("label_translations")
  sortOrder                Int           @map("sort_order")
  completedAt              DateTime?     @map("completed_at") @db.Timestamptz(6)
  completedByUserAccountId String?       @map("completed_by_user_account_id") @db.Uuid
  completedByPersonId      String?       @map("completed_by_person_id") @db.Uuid
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization             Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  task                     OperationTask @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  completedByUserAccount   UserAccount?  @relation("OperationTaskChecklistCompletedAccount", fields: [completedByUserAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  completedByPerson        Person?       @relation("OperationTaskChecklistCompletedPerson", fields: [completedByPersonId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, taskId, key], map: "operation_task_check_org_task_key_unique")
  @@index([organizationId, taskId, sortOrder], map: "operation_task_check_org_task_order_idx")
  @@map("operation_task_checklist_item")
}

model SyncOp {
  id                 String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  deviceId           String       @map("device_id")
  clientOpId         String       @map("client_op_id") @db.Uuid
  type               String
  status             String
  payload            Json
  result             Json?
  errorCode          String?      @map("error_code")
  actorUserAccountId String?      @map("actor_user_account_id") @db.Uuid
  actorPersonId      String?      @map("actor_person_id") @db.Uuid
  clientCreatedAt    DateTime?    @map("client_created_at") @db.Timestamptz(6)
  appliedAt          DateTime?    @map("applied_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actorUserAccount   UserAccount? @relation("SyncOpActorAccount", fields: [actorUserAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actorPerson        Person?      @relation("SyncOpActorPerson", fields: [actorPersonId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, deviceId, clientOpId], map: "sync_op_org_device_client_unique")
  @@index([organizationId, status, createdAt], map: "sync_op_org_status_created_idx")
  @@map("sync_op")
}

model LedgerAccount {
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String
  name           String
  accountType    String       @map("account_type")
  normalSide     String       @map("normal_side")
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  postings       Posting[]

  @@unique([organizationId, code], map: "ledger_account_org_code_unique")
  @@map("ledger_account")
}

model FinancialTransaction {
  id                     String                 @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId         String                 @map("organization_id") @db.Uuid
  reference              String
  occurredAt             DateTime               @map("occurred_at") @db.Timestamptz(6)
  description            String?
  reversesTransactionId  String?                @map("reverses_transaction_id") @db.Uuid
  createdBy              String?                @map("created_by") @db.Uuid
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  postings               Posting[]
  reversesTransaction    FinancialTransaction?  @relation("FinancialTransactionReversal", fields: [reversesTransactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversedByTransactions FinancialTransaction[] @relation("FinancialTransactionReversal")

  @@unique([organizationId, reference], map: "financial_transaction_org_reference_unique")
  @@index([organizationId, occurredAt], map: "financial_transaction_org_occurred_idx")
  @@map("financial_transaction")
}

model Posting {
  id              String               @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  transactionId   String               @map("transaction_id") @db.Uuid
  ledgerAccountId String               @map("ledger_account_id") @db.Uuid
  side            String
  amount          Decimal              @db.Decimal(18, 2)
  currency        String               @db.Char(3)
  bucket          String?
  dimensions      Json?
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  transaction     FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ledgerAccount   LedgerAccount        @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  currencyRef     Currency             @relation(fields: [currency], references: [code], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, transactionId], map: "posting_org_transaction_idx")
  @@index([organizationId, ledgerAccountId], map: "posting_org_account_idx")
  @@map("posting")
}

model RateLimitBucket {
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  keyHash        String       @map("key_hash")
  windowStart    DateTime     @map("window_start") @db.Timestamptz(6)
  windowSeconds  Int          @map("window_seconds")
  count          Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, keyHash, windowStart, windowSeconds], map: "rate_limit_bucket_unique_window")
  @@index([organizationId, windowStart], map: "rate_limit_bucket_org_window_idx")
  @@map("rate_limit_bucket")
}

model ReferenceSequence {
  organizationId String       @map("organization_id") @db.Uuid
  prefix         String
  nextValue      BigInt       @default(1) @map("next_value")
  width          Int          @default(4)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([organizationId, prefix])
  @@map("reference_sequence")
}

model Currency {
  code              String         @id @db.Char(3)
  name              String
  minorUnit         Int            @default(2) @map("minor_unit")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  exchangeRatesFrom ExchangeRate[] @relation("ExchangeRateFromCurrency")
  exchangeRatesTo   ExchangeRate[] @relation("ExchangeRateToCurrency")
  postings          Posting[]

  @@map("currency")
}

model ExchangeRate {
  id              String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  fromCurrency    String       @map("from_currency") @db.Char(3)
  toCurrency      String       @map("to_currency") @db.Char(3)
  rate            Decimal      @db.Decimal(18, 8)
  source          String
  effectiveAt     DateTime     @map("effective_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  fromCurrencyRef Currency     @relation("ExchangeRateFromCurrency", fields: [fromCurrency], references: [code], onDelete: Restrict, onUpdate: NoAction)
  toCurrencyRef   Currency     @relation("ExchangeRateToCurrency", fields: [toCurrency], references: [code], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, fromCurrency, toCurrency, effectiveAt], map: "exchange_rate_org_pair_effective_idx")
  @@map("exchange_rate")
}

model ConfigRule {
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String
  scopeType      String       @map("scope_type")
  scopeId        String?      @map("scope_id") @db.Uuid
  value          Json
  effectiveFrom  DateTime     @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime?    @map("effective_to") @db.Timestamptz(6)
  version        Int
  createdBy      String?      @map("created_by") @db.Uuid
  reason         String
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, key, scopeType, effectiveFrom], map: "config_rule_org_key_scope_effective_idx")
  @@map("config_rule")
}

model OutboxEvent {
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  type           String
  payload        Json
  status         String       @default("PENDING")
  idempotencyKey String       @map("idempotency_key")
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, idempotencyKey], map: "outbox_event_org_idempotency_key")
  @@index([organizationId, status, occurredAt], map: "outbox_event_org_status_occurred_idx")
  @@map("outbox_event")
}

model AuditLog {
  id              String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  actorId         String?      @map("actor_id") @db.Uuid
  action          String
  resourceType    String       @map("resource_type")
  resourceId      String?      @map("resource_id") @db.Uuid
  ipAddress       String?      @map("ip_address")
  deviceId        String?      @map("device_id")
  propertyScopeId String?      @map("property_scope_id") @db.Uuid
  before          Json?
  after           Json?
  reason          String?
  requestId       String       @map("request_id")
  occurredAt      DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, occurredAt], map: "audit_log_org_occurred_idx")
  @@index([organizationId, resourceType, resourceId], map: "audit_log_org_resource_idx")
  @@map("audit_log")
}
