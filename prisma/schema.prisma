model Expense {
  correctsExpenseId      String?                     @map("corrects_expense_id") @db.Uuid
  correctsExpenseVersion Int?                        @map("corrects_expense_version")
  correctsExpense        Expense?                    @relation("ExpenseCorrection", fields: [organizationId, correctsExpenseId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  corrections            Expense[]                   @relation("ExpenseCorrection")
  periodAdjustment       AccountingPeriodAdjustment?
  id                     String                      @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId         String                      @map("organization_id") @db.Uuid
  propertyId             String                      @map("property_id") @db.Uuid
  reservationId          String?                     @map("reservation_id") @db.Uuid
  fundingAccountId       String                      @map("funding_account_id") @db.Uuid
  transactionId          String?                     @map("transaction_id") @db.Uuid
  createdBy              String                      @map("created_by") @db.Uuid
  updatedBy              String                      @map("updated_by") @db.Uuid
  version                Int                         @default(1)
  state                  String                      @default("DRAFT")
  amount                 Decimal                     @db.Decimal(18, 2)
  currency               String                      @db.Char(3)
  category               String                      @db.VarChar(120)
  purpose                String                      @db.VarChar(1000)
  occurredOn             DateTime                    @map("occurred_on") @db.Date
  emergency              Boolean                     @default(false)
  idempotencyKey         String                      @map("idempotency_key") @db.Uuid
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization           Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  property               Property                    @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  reservation            Reservation?                @relation(fields: [organizationId, reservationId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  fundingAccount         LedgerAccount               @relation(fields: [organizationId, fundingAccountId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  transaction            FinancialTransaction?       @relation(fields: [organizationId, transactionId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  creator                UserAccount                 @relation("ExpenseCreator", fields: [organizationId, createdBy], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  updater                UserAccount                 @relation("ExpenseUpdater", fields: [organizationId, updatedBy], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  moneyCurrency          Currency                    @relation(fields: [currency], references: [code], onDelete: Restrict, onUpdate: NoAction)
