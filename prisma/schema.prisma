model InventoryStocktake {
  id               String             @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  propertyId       String?            @map("property_id") @db.Uuid
  taskId           String?            @map("task_id") @db.Uuid
  locationId       String             @map("location_id") @db.Uuid
  itemId           String             @map("item_id") @db.Uuid
  actorId          String             @map("actor_id") @db.Uuid
  configRuleId     String?            @map("config_rule_id") @db.Uuid
  expectedRevision BigInt             @map("expected_revision")
  revision         BigInt
  expectedQuantity Decimal            @map("expected_quantity") @db.Decimal(65, 0)
  countedQuantity  BigInt             @map("counted_quantity")
  note             String
  deviceId         String             @map("device_id") @db.VarChar(160)
  clientOpId       String             @map("client_op_id") @db.Uuid
  clientCreatedAt  DateTime?          @map("client_created_at") @db.Timestamptz(6)
  configSnapshot   Json               @map("config_snapshot")
  receivedAt       DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  property         Property?          @relation(fields: [organizationId, propertyId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  task             OperationTask?     @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  location         InventoryLocation  @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  item             InventoryItem      @relation(fields: [organizationId, itemId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  actor            UserAccount        @relation(fields: [organizationId, actorId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  configRule       ConfigRule?        @relation(fields: [organizationId, configRuleId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  movement         InventoryMovement?

  @@unique([organizationId, id])
  @@unique([organizationId, deviceId, clientOpId])
  @@unique([organizationId, locationId, itemId, revision])
  @@index([organizationId, taskId, receivedAt, id])
  @@map("inventory_stocktake")
}

