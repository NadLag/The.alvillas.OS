generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AutomationRun {
  id             String              @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  configRuleId   String              @map("config_rule_id") @db.Uuid
  ruleKey        String              @map("rule_key")
  eventId        String              @map("event_id") @db.Uuid
  eventKey       String              @map("event_key")
  propertyId     String?             @map("property_id") @db.Uuid
  actorId        String              @map("actor_id") @db.Uuid
  status         String              @default("PENDING")
  attemptCount   Int                 @default(0) @map("attempt_count")
  nextAttemptAt  DateTime?           @map("next_attempt_at") @db.Timestamptz(6)
  errorCode      String?             @map("error_code")
  inputs         Json
  outputs        Json                @default("[]")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?           @map("completed_at") @db.Timestamptz(6)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rule           ConfigRule          @relation(fields: [configRuleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  attempts       AutomationAttempt[]

  @@unique([organizationId, id])
  @@unique([organizationId, ruleKey, eventKey, propertyId])
  @@index([organizationId, status, nextAttemptAt])
  @@index([organizationId, propertyId, createdAt, id])
  @@map("automation_run")
}

model AutomationAttempt {
  id             String        @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  runId          String        @map("run_id") @db.Uuid
  number         Int
  status         String
  errorCode      String?       @map("error_code")
  outputs        Json
  requestId      String        @map("request_id")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  run            AutomationRun @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, runId, number])
  @@map("automation_attempt")
}

model AutomationSuggestion {
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  propertyId     String       @map("property_id") @db.Uuid
  outcomeKey     String       @map("outcome_key")
  itemKey        String       @map("item_key")
  title          Json
  quantity       Decimal      @db.Decimal(18, 2)
  status         String       @default("OPEN")
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, outcomeKey])
  @@index([organizationId, propertyId, status, createdAt], map: "automation_suggestion_org_property_status_created_idx")
  @@map("automation_suggestion")
}

model Organization {
  employeeContractWitnesses EmployeeCompensationContractWitness[]
  employeeRecognitions EmployeeCompensationRecognition[]
  employeeRecognitionLines EmployeeCompensationRecognitionLine[]
  employeeRecognitionRequests EmployeeCompensationRecognitionRequest[]
  employeeRecognitionOutcomes EmployeeCompensationRecognitionOutcome[]
  employeeSubmissionRequests EmployeeCompensationSubmissionRequest[]
  employeeSubmissionOutcomes EmployeeCompensationSubmissionOutcome[]
  employeeCompensationSubmissions                EmployeeCompensationSubmission[]
  employeeCompensationClaims                     EmployeeCompensationClaim[]
  employeeCompensationCosts                      EmployeeCompensationCost[]
  employeeCompensationWithdrawals                EmployeeCompensationWithdrawal[]
  employeeCompensationRuns EmployeeCompensationRun[]
  employeeCompensationRunLines EmployeeCompensationRunLine[]
  employeeCompensationRunCancellations EmployeeCompensationRunCancellation[]
  supplierInvoiceRecognitionRequests SupplierInvoiceRecognitionRequest[]
  supplierInvoiceRecognitionOutcomes SupplierInvoiceRecognitionOutcome[]
  supplierInvoiceRecognitions                    SupplierInvoiceRecognition[]
  supplierInvoiceRecognitionLines                SupplierInvoiceRecognitionLine[]
  supplierInvoiceSubmissions                     SupplierInvoiceSubmission[]
  supplierInvoices                               SupplierInvoice[]
  supplierInvoiceRevisions                       SupplierInvoiceRevision[]
  supplierInvoiceLines                           SupplierInvoiceLine[]
  suppliers                                      Supplier[]
  accountingPeriods                              AccountingPeriod[]
  accountingPeriodEvents                         AccountingPeriodEvent[]
  accountingPeriodAdjustments                    AccountingPeriodAdjustment[]
  expenses                                       Expense[]
  expenseSubmissions                             ExpenseSubmission[]
  financialApprovalStages                        ApprovalStage[]
  financialApprovalRecipients                    ApprovalStageRecipient[]
  cashCollections                                CashCollection[]
  automationRuns                                 AutomationRun[]
  automationAttempts                             AutomationAttempt[]
  automationSuggestions                          AutomationSuggestion[]
  teamCompensations                              TeamCompensation[]
  teamAvailabilities                             TeamAvailability[]
  teamDocuments                                  TeamDocument[]
  teamWallets                                    TeamWallet[]
  id                                             String                           @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  name                                           String
  baseCurrency                                   String                           @default("MAD") @map("base_currency") @db.Char(3)
  createdAt                                      DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                      DateTime                         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile                                        OrganizationProfile?
  regions                                        Region[]
  cities                                         City[]
  configRules                                    ConfigRule[]
  templateVersions                               PropertyTemplateVersion[]
  templateRevisions                              PropertyTemplateRevision[]
  reservationSnapshots                           ReservationConfigSnapshot[]
  outboxEvents                                   OutboxEvent[]
  notifications                                  Notification[]
  notificationPreferences                        NotificationPreference[]
  pushSubscriptions                              PushSubscription[]
  notificationDeliveries                         NotificationDelivery[]
  notificationDeliveryLogs                       NotificationDeliveryLog[]
  notificationEmailSuppressions                  NotificationEmailSuppression[]
  approvalRequests                               ApprovalRequest[]
  approvalRecipients                             ApprovalRecipient[]
  auditLogs                                      AuditLog[]
  referenceSequences                             ReferenceSequence[]
  exchangeRates                                  ExchangeRate[]
  ledgerAccounts                                 LedgerAccount[]
  transactions                                   FinancialTransaction[]
  transactionGroups                              TransactionGroup[]
  transactionGroupEntries                        TransactionGroupEntry[]
  postings                                       Posting[]
  commissionSnapshots                            CommissionSnapshot[]
  rateLimitBuckets                               RateLimitBucket[]
  persons                                        Person[]
  userAccounts                                   UserAccount[]
  authCredentials                                AuthCredential[]
  authSessions                                   AuthSession[]
  authDevices                                    AuthDevice[]
  authChallenges                                 AuthChallenge[]
  invitations                                    Invitation[]
  roles                                          Role[]
  permissions                                    Permission[]
  fieldPolicies                                  FieldPolicy[]
  roleAssignments                                RoleAssignment[]
  rolePermissions                                RolePermission[]
  owners                                         Owner[]
  ownerRepresentatives                           OwnerRepresentative[]
  ownerPayoutMethods                             OwnerPayoutMethod[]
  ownerPortalAccesses                            OwnerPortalAccess[]
  properties                                     Property[]
  propertyProfiles                               PropertyOnboardingProfile[]
  propertyOperatingProfiles                      PropertyOperatingProfile[]
  bookingChannels                                BookingChannel[]
  managementAgreements                           ManagementAgreement[]
  propertyOwners                                 PropertyOwner[]
  reservations                                   Reservation[]
  reservationConflicts                           ReservationConflict[]
  operationTasks                                 OperationTask[]
  operationTaskEvents                            OperationTaskEvent[]
  operationTaskMutations                         OperationTaskMutation[]
  operationSavedViews                            OperationSavedView[]
  operationEvidence                              OperationTaskEvidence[]
  operationUploads                               OperationEvidenceUpload[]
  operationIssues                                OperationIssue[]
  taskChecklistItems                             OperationTaskChecklistItem[]
  syncOps                                        SyncOp[]
  airbnbSettlements                              AirbnbSettlement[]
  variances                                      Variance[]
  reservationGuestRecordRecords                  GuestRecord[]                    @relation("ReservationGuestRecordOrganization")
  reservationReservationFeedRecords              ReservationFeed[]                @relation("ReservationReservationFeedOrganization")
  reservationReservationFeedEntryRecords         ReservationFeedEntry[]           @relation("ReservationReservationFeedEntryOrganization")
  reservationFeedSyncRunRecords                  FeedSyncRun[]                    @relation("ReservationFeedSyncRunOrganization")
  reservationReservationRevisionRecords          ReservationRevision[]            @relation("ReservationReservationRevisionOrganization")
  reservationReservationFinancialSnapshotRecords ReservationFinancialSnapshot[]   @relation("ReservationReservationFinancialSnapshotOrganization")
  reservationCalendarBlockRecords                CalendarBlock[]                  @relation("ReservationCalendarBlockOrganization")
  reservationReservationImportBatchRecords       ReservationImportBatch[]         @relation("ReservationReservationImportBatchOrganization")
  reservationReservationExceptionRecords         ReservationException[]           @relation("ReservationReservationExceptionOrganization")

  inventoryItems        InventoryItem[]
  inventoryLocations    InventoryLocation[]
  inventoryStockCursors InventoryStockCursor[]
  inventoryStocktakes   InventoryStocktake[]
  inventoryMovements    InventoryMovement[]

  @@map("organization")
}

model Region {
  employeeCompensationSources EmployeeCompensationRunLine[] @relation("EmployeeRunSourceRegion")
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  code           String?
  description    String?
  sortOrder      Int          @default(0) @map("sort_order")
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  cities         City[]
  properties     Property[]

  @@index([organizationId, archivedAt, sortOrder, name], map: "region_org_archived_sort_idx")
  @@map("region")
  @@unique([organizationId, id])
}

model City {
  employeeCompensationSources EmployeeCompensationRunLine[] @relation("EmployeeRunSourceCity")
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  regionId       String?      @map("region_id") @db.Uuid
  name           String
  countryCode    String       @default("MA") @map("country_code") @db.Char(2)
  timezone       String       @default("Africa/Casablanca")
  sortOrder      Int          @default(0) @map("sort_order")
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  region         Region?      @relation(fields: [regionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  properties     Property[]

  @@index([organizationId, regionId, archivedAt, sortOrder, name], map: "city_org_region_archived_sort_idx")
  @@index([organizationId, archivedAt, name], map: "city_org_archived_name_idx")
  @@map("city")
  @@unique([organizationId, id])
}

model OrganizationProfile {
  organizationId       String       @id @map("organization_id") @db.Uuid
  legalName            String?      @map("legal_name")
  brandName            String       @map("brand_name")
  logoUrl              String?      @map("logo_url")
  primaryColor         String       @default("#0B6B5F") @map("primary_color")
  accentColor          String       @default("#9F3F1B") @map("accent_color")
  websiteUrl           String?      @map("website_url")
  supportEmail         String?      @map("support_email")
  supportPhone         String?      @map("support_phone")
  defaultLocale        String       @default("fr") @map("default_locale") @db.Char(2)
  timezone             String       @default("Africa/Casablanca")
  countryCode          String       @default("MA") @map("country_code") @db.Char(2)
  fiscalYearStartMonth Int          @default(1) @map("fiscal_year_start_month")
  settings             Json         @default("{}")
  createdBy            String?      @map("created_by") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([countryCode, defaultLocale], map: "organization_profile_country_locale_idx")
  @@map("organization_profile")
}

model TeamCompensation {
  monthlyWitnesses EmployeeCompensationContractWitness[]
  runLines EmployeeCompensationRunLine[]
  currencyRef    Currency       @relation(fields: [currency], references: [code], onDelete: Restrict, onUpdate: NoAction, map: "team_compensation_currency_fkey")
  configRule     ConfigRule     @relation(fields: [configRuleId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "team_compensation_config_fkey")
  id             String         @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  assignmentId   String         @map("assignment_id") @db.Uuid
  configRuleId   String         @map("config_rule_id") @db.Uuid
  version        Int
  mode           String
  amount         Decimal        @db.Decimal(18, 2)
  currency       String         @db.Char(3)
  effectiveFrom  DateTime       @map("effective_from") @db.Timestamptz(6)
  reason         String
  createdBy      String         @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignment     RoleAssignment @relation(fields: [organizationId, assignmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, assignmentId, version], map: "team_compensation_org_assignment_version_unique")
  @@unique([organizationId, id], map: "team_compensation_org_id_unique")
  @@index([organizationId, assignmentId, effectiveFrom], map: "team_compensation_org_assignment_effective_idx")
  @@map("team_compensation")
}

model TeamAvailability {
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  personId       String       @map("person_id") @db.Uuid
  kind           String
  startsOn       DateTime     @map("starts_on") @db.Date
  endsOn         DateTime     @map("ends_on") @db.Date
  status         String
  reason         String
  decidedBy      String?      @map("decided_by") @db.Uuid
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  person         Person       @relation(fields: [organizationId, personId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, personId, startsOn, endsOn], map: "team_availability_org_person_dates_idx")
  @@index([organizationId, personId, status, startsOn, endsOn], map: "team_availability_org_person_status_dates_idx")
  @@map("team_availability")
}

model TeamDocument {
  id             String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  personId       String       @map("person_id") @db.Uuid
  title          String
  kind           String
  storageKey     String       @unique @map("storage_key")
  contentType    String       @map("content_type")
  size           Int
  expiresOn      DateTime?    @map("expires_on") @db.Date
  confirmedAt    DateTime?    @map("confirmed_at") @db.Timestamptz(6)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  person         Person       @relation(fields: [organizationId, personId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, personId, archivedAt, createdAt], map: "team_document_org_person_created_idx")
  @@index([organizationId, expiresOn], map: "team_document_org_expiry_idx")
  @@map("team_document")
}

model TeamWallet {
  id              String        @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  personId        String        @unique @map("person_id") @db.Uuid
  ledgerAccountId String        @unique @map("ledger_account_id") @db.Uuid
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  person          Person        @relation(fields: [organizationId, personId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  ledgerAccount   LedgerAccount @relation(fields: [organizationId, ledgerAccountId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, personId], map: "team_wallet_org_person_unique")
  @@unique([organizationId, ledgerAccountId], map: "team_wallet_org_account_unique")
  @@index([organizationId, personId], map: "team_wallet_org_person_idx")
  @@map("team_wallet")
}

model Person {
  employeeCompensationClaims EmployeeCompensationClaim[]
  compensationRunLines EmployeeCompensationRunLine[]
  cashCollections    CashCollection[]
  teamAvailabilities TeamAvailability[]
  teamDocuments      TeamDocument[]
  teamWallet         TeamWallet?
  id                 String                       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId     String                       @map("organization_id") @db.Uuid
  displayName        String                       @map("display_name")
  email              String?
  phone              String?
  preferredLocale    String                       @default("en") @map("preferred_locale") @db.Char(2)
  archivedAt         DateTime?                    @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  userAccounts       UserAccount[]
  assignedTasks      OperationTask[]              @relation("OperationTaskAssignedPerson")
  completedTasks     OperationTask[]              @relation("OperationTaskCompletedPerson")
  completedChecks    OperationTaskChecklistItem[] @relation("OperationTaskChecklistCompletedPerson")
  syncOps            SyncOp[]                     @relation("SyncOpActorPerson")
  invitations        Invitation[]
  roleAssignments    RoleAssignment[]

  @@unique([organizationId, email], map: "person_org_email_unique")
  @@unique([organizationId, id], map: "person_org_id_unique")
  @@index([organizationId, phone], map: "person_org_phone_idx")
  @@index([organizationId, displayName], map: "person_org_display_name_idx")
  @@map("person")
}

model UserAccount {
  employeeRecognitions EmployeeCompensationRecognition[] @relation("EmployeeRecognitionCreator")
  employeeRecognitionRequests EmployeeCompensationRecognitionRequest[] @relation("EmployeeRecognitionRequester")
  employeeSubmissionRequests EmployeeCompensationSubmissionRequest[] @relation("EmployeeSubmissionRequester")
  employeeCompensationSubmissions    EmployeeCompensationSubmission[]      @relation("EmployeeSubmissionCreator")
  employeeCompensationWithdrawals    EmployeeCompensationWithdrawal[]      @relation("EmployeeSubmissionWithdrawer")
  createdCompensationRuns EmployeeCompensationRun[] @relation("EmployeeRunCreator")
  cancelledCompensationRuns EmployeeCompensationRunCancellation[] @relation("EmployeeRunCanceller")
  supplierInvoiceRecognitionRequests SupplierInvoiceRecognitionRequest[]
  supplierInvoiceRecognitions SupplierInvoiceRecognition[] @relation("SupplierInvoiceRecognitionCreator")
  submittedSupplierInvoices   SupplierInvoiceSubmission[]
  createdSupplierInvoices     SupplierInvoice[]            @relation("SupplierInvoiceCreator")
  updatedSupplierInvoices     SupplierInvoice[]            @relation("SupplierInvoiceUpdater")
  supplierInvoiceRevisions    SupplierInvoiceRevision[]
  supplierInvoiceLines        SupplierInvoiceLine[]
  createdSuppliers            Supplier[]                   @relation("SupplierCreatedBy")
  accountingPeriods           AccountingPeriod[]           @relation("AccountingPeriodCreator")
  accountingPeriodEvents      AccountingPeriodEvent[]      @relation("AccountingPeriodActor")
  accountingPeriodAdjustments AccountingPeriodAdjustment[] @relation("AccountingPeriodAdjustmentCreator")
  createdTransactionGroups    TransactionGroup[]
  transactionGroupEntries     TransactionGroupEntry[]
  createdExpenses             Expense[]                    @relation("ExpenseCreator")
  updatedExpenses             Expense[]                    @relation("ExpenseUpdater")
  expenseSubmissions          ExpenseSubmission[]
  decidedFinancialStages      ApprovalStage[]
  financialApprovalRecipients ApprovalStageRecipient[]
  cashCollections             CashCollection[]
  operationUploads            OperationEvidenceUpload[]
  requestedApprovals          ApprovalRequest[]            @relation("ApprovalRequester")
  decidedApprovals            ApprovalRequest[]            @relation("ApprovalDecider")
  id                          String                       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId              String                       @map("organization_id") @db.Uuid
  personId                    String                       @map("person_id") @db.Uuid
  email                       String?
  phone                       String?
  passwordHash                String?                      @map("password_hash")
  status                      String                       @default("ACTIVE")
  sessionVersion              Int                          @default(1) @map("session_version")
  mfaRequired                 Boolean                      @default(false) @map("mfa_required")
  lastLoginAt                 DateTime?                    @map("last_login_at") @db.Timestamptz(6)
  suspendedAt                 DateTime?                    @map("suspended_at") @db.Timestamptz(6)
  deactivatedAt               DateTime?                    @map("deactivated_at") @db.Timestamptz(6)
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  person                      Person                       @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  authCredentials             AuthCredential[]
  authSessions                AuthSession[]
  authDevices                 AuthDevice[]
  authChallenges              AuthChallenge[]
  invitations                 Invitation[]
  roleAssignments             RoleAssignment[]
  assignedTasks               OperationTask[]              @relation("OperationTaskAssignedAccount")
  completedTasks              OperationTask[]              @relation("OperationTaskCompletedAccount")
  completedChecks             OperationTaskChecklistItem[] @relation("OperationTaskChecklistCompletedAccount")
  operationViews              OperationSavedView[]
  syncOps                     SyncOp[]                     @relation("SyncOpActorAccount")
  ownerPortalAccesses         OwnerPortalAccess[]
  notifications               Notification[]
  approvalRecipients          ApprovalRecipient[]
  notificationPreference      NotificationPreference?
  pushSubscriptions           PushSubscription[]
  notificationDeliveries      NotificationDelivery[]

  inventoryStocktakes InventoryStocktake[]
  inventoryMovements  InventoryMovement[]

  @@unique([organizationId, id], map: "user_account_org_id_unique")
  @@unique([organizationId, email], map: "user_account_org_email_unique")
  @@unique([organizationId, phone], map: "user_account_org_phone_unique")
  @@index([organizationId, personId], map: "user_account_org_person_idx")
  @@index([organizationId, status], map: "user_account_org_status_idx")
  @@map("user_account")
}

model AuthCredential {
  id              String       @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  userAccountId   String       @map("user_account_id") @db.Uuid
  type            String
  label           String?
  secretHash      String?      @map("secret_hash")
  secretEncrypted String?      @map("secret_encrypted")
  credentialId    String?      @map("credential_id")
  publicKey       Bytes?       @map("public_key")
  counter         Int          @default(0)
  transports      Json?
  backupEligible  Boolean      @default(false) @map("backup_eligible")
  backedUp        Boolean      @default(false) @map("backed_up")
  lastUsedAt      DateTime?    @map("last_used_at") @db.Timestamptz(6)
  expiresAt       DateTime?    @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  userAccount     UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, type, credentialId], map: "auth_credential_org_type_credential_unique")
  @@index([organizationId, userAccountId, type, revokedAt], map: "auth_credential_org_user_type_idx")
  @@map("auth_credential")
}

model AuthSession {
  pushSubscriptions PushSubscription[]
  id                String             @id @default(dbgenerated("app_uuid_v7()")) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  userAccountId     String             @map("user_account_id") @db.Uuid
  deviceId          String             @map("device_id")
  sessionVersion    Int                @map("session_version")
