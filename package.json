{
  "name": "alvillas-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "bootstrap:first-admin": "tsx prisma/bootstrap-admin.ts",
    "seed:demo": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "check:i18n": "tsx tests/scripts/check-i18n.ts",
    "check:rtl-css": "tsx tests/scripts/check-rtl-css.ts",
    "check:design-system": "tsx tests/scripts/check-design-system.ts",
    "check:boundaries": "tsx tests/scripts/check-boundaries.ts",
    "check:organization-id": "tsx tests/scripts/check-organization-id.ts",
    "check:schema-drift": "tsx tests/scripts/check-schema-drift.ts",
    "check:ledger": "tsx tests/scripts/check-ledger.ts",
    "check:audit": "tsx tests/scripts/check-audit.ts",
    "check:progress": "tsx tests/scripts/check-progress.ts",
    "progress:report": "tsx tests/scripts/progress-report.ts",
    "progress:set": "tsx tests/scripts/set-progress-note.ts",
    "rehearse:restore": "tsx scripts/rehearse-backup-restore.ts",
    "verify": "npm run lint && npm run typecheck && npm run check:i18n && npm run check:rtl-css && npm run check:design-system && npm run check:boundaries && npm run check:organization-id && npm run check:ledger && npm run check:audit && npm run check:progress && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.12.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@simplewebauthn/browser": "^9.0.1",
    "@simplewebauthn/server": "^9.0.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.18",
    "argon2": "^0.45.1",
    "decimal.js": "^10.6.0",
    "inngest": "^4.24.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.56.0",
    "next": "^16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "svix": "2.8.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "^6.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
