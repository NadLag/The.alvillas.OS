    "ops.checklists": {
      "checklists": [
        {
          "key": "automation-cleaning",
          "name": {
            "en": "Schedule mid-stay cleaning",
            "fr": "Planifier le ménage de mi-séjour",
            "ar": "جدولة تنظيف منتصف الإقامة"
          },
          "items": [
            {
              "key": "verified",
              "label": {
                "en": "Schedule mid-stay cleaning",
                "fr": "Planifier le ménage de mi-séjour",
                "ar": "جدولة تنظيف منتصف الإقامة"
              }
            }
          ]
        }
      ]
    },
    "ops.mid_stay_threshold": {
      "nights": 4
    }
  },
  "rules": [
    {
      "key": "stay-workflow",
      "rule": {
        "name": {
          "en": "Generate the stay workflow",
          "fr": "Générer le parcours du séjour",
          "ar": "إنشاء سير عمل الإقامة"
        },
        "event": "ReservationConfirmed",
        "enabled": true,
        "conditions": {
          "all": []
        },
        "actions": [
          {
            "key": "workflow",
            "type": "generate_workflow"
          }
        ],
        "retry": {
          "max_attempts": 5,
          "delay_seconds": 60
        }
      }
    },
    {
      "key": "midstay-cleaning",
      "rule": {
        "name": {
          "en": "Schedule mid-stay cleaning",
          "fr": "Planifier le ménage de mi-séjour",
          "ar": "جدولة تنظيف منتصف الإقامة"
        },
        "event": "ReservationConfirmed",
        "enabled": true,
        "conditions": {
          "path": "reservation.nights",
          "op": ">=",
          "value": {
            "config": "ops.mid_stay_threshold",
            "path": "nights"
          }
        },
        "actions": [
          {
            "key": "midstay",
            "type": "create_task",
            "task_type": "CLEANING_MIDSTAY",
            "title": {
              "en": "Schedule mid-stay cleaning",
              "fr": "Planifier le ménage de mi-séjour",
              "ar": "جدولة تنظيف منتصف الإقامة"
            },
            "due": {
              "offset_days": "floor(nights/2)",
              "from": "reservation.check_in"
            },
            "priority": "NORMAL",
            "checklist_template": "automation-cleaning"
          }
        ],
        "retry": {
          "max_attempts": 5,
          "delay_seconds": 60
        }
      }
    },
    {
      "key": "reorder",
      "rule": {
        "name": {
          "en": "Suggest stock replenishment",
          "fr": "Proposer le réapprovisionnement",
          "ar": "اقتراح تجديد المخزون"
        },
        "event": "InventoryBelowMinimum",
        "enabled": true,
        "conditions": {
          "all": []
        },
        "actions": [
          {
            "key": "suggest",
            "type": "reorder_suggestion",
            "title": {
              "en": "Suggest stock replenishment",
              "fr": "Proposer le réapprovisionnement",
              "ar": "اقتراح تجديد المخزون"
            }
          }
        ],
        "retry": {
          "max_attempts": 5,
          "delay_seconds": 60
        }
      }
    },
    {
      "key": "approval",
      "rule": {
        "name": {
          "en": "Request threshold approval",
          "fr": "Demander la validation du seuil",
          "ar": "طلب الموافقة على الحد"
        },
        "event": "ExpenseOverThreshold",
        "enabled": true,
        "conditions": {
          "all": []
        },
        "actions": [
          {
            "key": "request",
            "type": "create_approval_request",
            "title": {
              "en": "Request threshold approval",
              "fr": "Demander la validation du seuil",
              "ar": "طلب الموافقة على الحد"
            },
            "details": {
              "en": "Request threshold approval",
              "fr": "Demander la validation du seuil",
              "ar": "طلب الموافقة على الحد"
            }
          }
        ],
        "retry": {
          "max_attempts": 5,
          "delay_seconds": 60
        }
      }
    },
    {
      "key": "overdue-notice",
      "rule": {
        "name": {
          "en": "Notify overdue task assignees",
          "fr": "Notifier les tâches en retard",
          "ar": "إشعار المكلفين بالمهام المتأخرة"
        },
        "event": "TaskOverdue",
        "enabled": true,
        "conditions": {
          "path": "task.assigned_to",
          "op": "exists"
        },
        "actions": [
          {
            "key": "notify",
            "type": "notify",
            "kind": "task_overdue",
            "recipient": "task.assigned_to",
            "target": "task.id"
          }
        ],
        "retry": {
          "max_attempts": 5,
          "delay_seconds": 60
        }
      }
    },
    {
      "key": "financial-snapshot",
      "rule": {
        "name": {
          "en": "Capture confirmation rules",
          "fr": "Figer les règles à la confirmation",
          "ar": "حفظ قواعد التأكيد"
        },
        "event": "ReservationConfirmed",
        "enabled": true,
        "conditions": {
          "all": []
        },
        "actions": [
          {
            "key": "snapshot",
            "type": "snapshot"
          }
        ],
        "retry": {
          "max_attempts": 5,
          "delay_seconds": 60
        }
      }
    },
    {
      "key": "stocktake-variance",
      "rule": {
        "name": {
          "en": "Open a stocktake variance",
          "fr": "Ouvrir un écart d’inventaire",
          "ar": "فتح فرق الجرد"
        },
        "event": "StocktakeVariance",
        "enabled": true,
        "conditions": {
          "all": []
        },
        "actions": [
          {
            "key": "variance",
            "type": "create_variance",
            "expected": "variance.expected",
            "actual": "variance.actual",
            "currency": "variance.currency",
            "reason": {
              "en": "Open a stocktake variance",
              "fr": "Ouvrir un écart d’inventaire",
              "ar": "فتح فرق الجرد"
            }
          }
        ],
        "retry": {
          "max_attempts": 5,
          "delay_seconds": 60
        }
      }
    }
  ]
}
